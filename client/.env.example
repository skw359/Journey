# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_,
# and inlines them at BUILD time -- rebuild the client after changing them.

# CARTO Basemaps key. Without it, raster basemap tiles render with an
# "API key required" watermark. Request one at https://carto.com/basemaps/apikey/
# Public by design (it ships in the browser bundle) -- keep real secrets in the
# server-side .env at the project root instead.
VITE_CARTO_KEY=
